    {
      "name": "Module 2 - sessions and joining",
      "item": [
        {
          "name": "1 A host starts a game: POST /sessions -> 201, LOBBY, six-digit code",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Demo-User", "value": "{{host}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\"max_players\":4}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/sessions", "host": ["{{baseUrl}}"], "path": ["sessions"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Status is LOBBY\", function () { pm.expect(pm.response.json().status).to.equal(\"LOBBY\"); });",
                  "pm.test(\"Code is six digits\", function () { pm.expect(pm.response.json().code).to.match(/^[1-9][0-9]{5}$/); });",
                  "pm.collectionVariables.set(\"code\", pm.response.json().code);",
                  "pm.collectionVariables.set(\"session_id\", pm.response.json().session_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2 A player tries to start a game -> 403",
